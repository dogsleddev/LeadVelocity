%% LeadVelocity lead agent pipeline, revision 2.
%%
%% Only one thing changed from v1, at node I.
%%
%% v1 hired a generic expert to resolve a blocking unknown. v2 hires a SPECIFIC
%% expert: a licensed commercial electrical contractor in San Francisco. That is
%% the same person the Sales Agent is trying to find, so the single paid
%% interaction now produces two assets instead of one:
%%
%%   J  the evidence upgrade that was always the point
%%   P  a qualified, consenting prospect who has just been shown a real project
%%
%% The dashed edge I -> P is the acquisition channel. Nothing else moves.
flowchart TD
    A["1. Load subscriber profile + territory"] --> B["2. Pull new or changed SF permit records, tracked via data_as_of and data_loaded_at"]
    B --> C["3. Deterministic filters: geography, status, project type, cost floor, dedupe"]
    C --> D["4. AI shortlist: interpret permit descriptions for demand in the subscriber's trade"]
    D --> E["5. Targeted enrichment, shortlist only: permit contacts join, CSLB license verify, Places confirm"]
    E --> F["6. Findings written with evidence labels: verified, corroborated, inferred, unknown"]
    F --> G["7. Deterministic score: fit 30, demand 25, timing 20, value 15, evidence 10"]
    G --> H{"Blocking unknown with high potential value?"}

    H -->|"yes"| I["Terac panel: recruit licensed C-10 commercial contractors in SF.<br/>Filters: city, industry, seniority, company size.<br/>Screening: C-10 held, bids commercial, works SF, consent.<br/>They answer: is the electrical scope still open, who to call, what it is worth"]

    I --> J["Evidence label upgraded, rescore"]
    I -.->|"same paid interaction, second asset"| P["Qualified prospect:<br/>identity verified, licence number self reported"]
    P --> Q["CSLB lookup on the reported licence number"]
    Q --> R{"Opted in to contact?"}
    R -->|"yes"| S["Sales Agent: consenting prospect,<br/>already shown a real job"]
    R -->|"no"| T["Recorded, never contacted"]

    J --> K{"8. Score >= 80?"}
    H -->|"no"| K
    K -->|"yes"| L["Deliver: SMS to subscriber + web detail with evidence, timing, best path in"]
    K -->|"no"| M["Archive: zero leads on a weak day beats noise"]
    L --> N["Feedback reply: good, too small, wrong scope"]
    N --> O["Customer Agent updates the effective profile"]
    O -.->|"next run starts sharper"| A

    subgraph LEGEND["Legend: who does what"]
        direction LR
        L1["Deterministic code"]
        L2["AI judgment"]
        L3["Human expert on demand"]
        L4["Acquisition side effect"]
    end

    classDef det fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ai fill:#faf5ff,stroke:#9333ea,stroke-width:2px,color:#581c87
    classDef human fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    classDef gate fill:#fefce8,stroke:#ca8a04,stroke-width:2px,color:#713f12
    classDef outcome fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b
    classDef acq fill:#fdf2f8,stroke:#db2777,stroke-width:2px,color:#831843

    class A,B,C,F,G,J,M,O,Q,T,L1 det
    class D,E,N,L2 ai
    class I,L3 human
    class H,K,R gate
    class L outcome
    class P,S,L4 acq
