{
  "name": "leadvelocity",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous subscription lead company for commercial contractors. From Permit to Pipeline.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "replay": "tsx --env-file-if-exists=.env.local scripts/replay.ts",
    "workers": "tsx --env-file-if-exists=.env.local scripts/workers.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "study": "tsx --env-file-if-exists=.env.local scripts/study.ts",
    "recruit": "tsx --env-file-if-exists=.env.local scripts/recruit.ts",
    "extract": "tsx --env-file-if-exists=.env.local scripts/extract.ts",
    "linq:sync": "tsx --env-file-if-exists=.env.local scripts/linq-sync.ts",
    "lead": "tsx --env-file-if-exists=.env.local scripts/lead-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@linqapp/sdk": "^0.39.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.3.1",
    "twilio": "^5.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
