# LeadVelocity environment.
# Secrets live in env only. Never commit a filled-in copy of this file.
# render.yaml declares every secret below with `sync: false` (presence-only);
# non-secret selectors and tunables carry a plain value there instead.
#
# Delivery channel: Linq is primary, Twilio is the implemented fallback. See the
# DELIVERY_CHANNEL block below and docs/BLOCKERS.md section 3.

# --- Supabase (persistence) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Build and test in test mode. The event-day demo checkout runs LIVE through a
# Stripe individual account (Best Overall eligibility rule, kickoff section 10.3).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PAYMENT_LINK_URL=

# --- Delivery channel selector ---
# `linq` (default) or `twilio`. Both are implemented behind
# lib/delivery/channel.ts, so switching channels is this one variable and a
# restart, never a code change. Leave it on linq unless Linq is down.
DELIVERY_CHANNEL=linq

# --- Linq (PRIMARY delivery channel: iMessage, RCS or SMS) ---
# Required to send. Auth header is `Authorization: Bearer <LINQ_API_V3_API_KEY>`.
LINQ_API_V3_API_KEY=
# Required to trust inbound webhooks. This is the `signing_secret` of the
# webhook subscription you create in the Linq dashboard, pointed at
# https://<your-render-url>/api/linq/inbound and subscribed to message.received.
# Without it, inbound bodies are refused rather than parsed. See docs/BLOCKERS.md section 3.
LINQ_WEBHOOK_SECRET=
# Optional override. Defaults to https://api.linqapp.com/api/partner
LINQ_API_V3_BASE_URL=
# Optional. Linq picks a line if this is unset.
LINQ_FROM_NUMBER=
# The hackathon sandbox will only message handles that texted the Linq number
# first, so this stays false and the Sales Agent queues instead of cold sending.
# Set true ONLY on a production Linq number that has no such restriction.
LINQ_ALLOW_COLD_OUTBOUND=false

# --- Twilio (FALLBACK delivery channel, reached by DELIVERY_CHANNEL=twilio) ---
# Not deleted and not dead code. Twilio stays wired behind the same seam so a
# Linq outage at the venue is a config flip rather than a rewrite. Twilio has no
# inbound-first restriction, so cold outbound works on this path.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Anthropic (agent reasoning) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Terac (required, event rule: GenPop study) ---
# REST API. Auth is `Authorization: Bearer <TERAC_API_KEY>`.
# Base URL defaults to the v2 external API; override only if Terac says otherwise.
TERAC_API_KEY=
TERAC_BASE_URL=https://terac.com/api/external/v2
# Reuse one project across runs instead of creating a new one each time.
TERAC_PROJECT_ID=
# Panel size requested for the message study.
TERAC_TARGET_RESPONDENTS=50
TERAC_TIMELINE_HOURS=72
TERAC_BUSINESS_TYPE=b2c
TERAC_TIMEOUT_MS=25000
# Ceiling, in cents, the Sales Agent may authorize itself for a panel.
# 0 means the company may never spend on its own; a human runs
# `npm run study -- launch --max-usd=N` instead. See docs/BLOCKERS.md section 4.
TERAC_STUDY_BUDGET_CENTS=0

# There is also an MCP server at https://terac.com/api/mcp (HTTP transport,
# OAuth on first connect). This build talks to the REST API directly so the
# workers can run headless on Render, where an interactive OAuth flow is not
# available. Connect the MCP server in your editor if you want to drive studies
# by hand alongside the automated path.

# --- DataSF Socrata (optional token raises rate limits) ---
SODA_APP_TOKEN=

# --- App / demo wiring ---
APP_BASE_URL=http://localhost:3000
DEMO_PHONE_NUMBER=
REPLAY_SPEED_MULTIPLIER=60
KILL_SWITCH_DEFAULT=off

# The published subscription price, whole US dollars per month. One variable,
# read by lib/config/deployment-env.ts and by nothing else, so the price quoted
# in a Sales message, on the public sample, on the subscriber's profile and as
# revenue on both owner screens can never disagree. 149 is the kickoff persona's
# number; leave it unless the offer itself changes.
SUBSCRIPTION_PRICE_USD=149

# Worker tick cadence in seconds (local `npm run workers`).
LEAD_TICK_SECONDS=45
SALES_TICK_SECONDS=120
CUSTOMER_TICK_SECONDS=30
CEO_TICK_SECONDS=300
